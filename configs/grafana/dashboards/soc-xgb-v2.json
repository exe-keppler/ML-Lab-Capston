{
  "uid": "soc-xgb-v2",
  "title": "SOC Enterprise \u2014 XGBoost v2",
  "tags": [
    "soc",
    "ml",
    "xgboost",
    "ids-ml-lab"
  ],
  "editable": true,
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## XGBoost v2 (tuned) SOC \u2014 Detecci\u00f3n por ML\n\nPredicciones del **XGBoost v2 (tuned) v2 tuned** sobre flujos en vivo. Datos via Loki (`{job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\"`). Filtrado por `model=xgb` para aislar este detector \u2014 el sensor emite predicciones de RF y XGBoost en el mismo stream pero con campo `model` distinto."
      }
    },
    {
      "id": 1,
      "title": "Predicciones por minuto (attack vs benign)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (is_attack) (count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" | json is_attack=\"is_attack\" [1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Distribuci\u00f3n de categor\u00edas",
      "type": "piechart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (category) (count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" | json category=\"category\" [15m]))",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true
        }
      }
    },
    {
      "id": 3,
      "title": "Volumen total de flujos clasificados",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" [15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ataques detectados (total 15m)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" |~ \"\\\"is_attack\\\":true\" [15m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tasa de ataque (% sobre total)",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "100 * sum(count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" |~ \"\\\"is_attack\\\":true\" [15m])) / sum(count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" [15m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Categor\u00eda predicha m\u00e1s confiada",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 11,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(1, sum by (category) (count_over_time({job=\"sensor\"} |~ \"\\\"model\\\":\\\"xgb\\\"\" | json category=\"category\" |~ \"\\\"confidence\\\":0\\\\.[89]\" [15m])))",
          "refId": "A"
        }
      ]
    },
