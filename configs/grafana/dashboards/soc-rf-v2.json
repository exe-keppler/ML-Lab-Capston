      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"ml_predictions\", model=\"rf\", is_attack=\"true\"} [30m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
