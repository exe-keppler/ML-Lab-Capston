{
  "uid": "soc-suricata",
  "title": "SOC Enterprise \u2014 Suricata (rule-based)",
  "tags": [
    "soc",
    "suricata",
    "ids-ml-lab"
  ],
  "editable": true,
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "## Suricata SOC \u2014 IDS rule-based\n\nTr\u00e1fico monitoreado por **Suricata + ET-Open (~50k reglas)** sobre el bridge `ids_network`. Vista enterprise: alertas por tiempo, top firmas, severidad, protocolos, IPs. Datos via Loki (`{job=\"suricata\"}`, eve.json)."
      }
    },
    {
      "id": 1,
      "title": "Volumen de alertas (rolling)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"suricata\"} |~ \"\\\"event_type\\\":\\\"alert\\\"\" [1m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Severidad de alertas (1=cr\u00edtica, 3=info)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (sev) (count_over_time({job=\"suricata\"} |~ \"\\\"event_type\\\":\\\"alert\\\"\" | json | line_format \"{{.alert_severity}}\" | label_format sev=\"{{.alert_severity}}\" [5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Top firmas (signature) \u2014 \u00faltimos 15 min",
      "type": "barchart",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (signature) (count_over_time({job=\"suricata\"} |~ \"\\\"event_type\\\":\\\"alert\\\"\" | json signature=\"alert.signature\" [15m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
