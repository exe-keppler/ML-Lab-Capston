    },
    {
      "id": 10,
      "title": "Stream de alertas (\u00faltimas 50)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"suricata\"} |= \"\\\"event_type\\\":\\\"alert\\\"\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
