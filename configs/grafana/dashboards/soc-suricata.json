        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 15,
        "w": 6,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (dest_ip) (count_over_time({job=\"suricata\"} |= \"\\\"event_type\\\":\\\"alert\\\"\" | json dest_ip=\"dest_ip\" [30m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
