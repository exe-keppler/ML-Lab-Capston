          },
          "expr": "topk(10, sum by (src_ip) (count_over_time({job=\"suricata\"} |= \"\\\"event_type\\\":\\\"alert\\\"\" | json src_ip=\"src_ip\" [30m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
